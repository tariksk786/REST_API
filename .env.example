# InternHub API Configuration
PORT=3000
NODE_ENV=development

# Persistent SQLite database file path (relative or absolute)
DB_PATH=./data/internhub.db

# CORS origin for frontend integration (e.g., http://localhost:5173 or * for local dev)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
